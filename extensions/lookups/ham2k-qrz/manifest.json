{
  "key": "ham2k-qrz",
  "name": "QRZ.com Callsign Lookups",
  "version": "0.4.0",
  "api": 31,
  "description": "Looks up callsign details with a QRZ.com account, and pushes your contacts to QRZ.com Logbook",
  "category": "lookup",
  "keywords": [
    "callsign",
    "lookup",
    "qrz"
  ],
  "hooks": [
    "account",
    "lookup",
    "settingsPanel",
    "transfer"
  ],
  "settings": {
    "section": "exports"
  },
  "domains": [
    "*.qrz.com"
  ],
  "sharedDependencies": {
    "@ham2k/lib-callsigns": "^1.0.0",
    "@ham2k/lib-country-files": "^1.0.0",
    "@ham2k/lib-dxcc-data": "^1.0.0",
    "@ham2k/lib-format-tools": "^1.0.0",
    "@ham2k/lib-geo-tools": "^1.0.0",
    "@ham2k/lib-operation-data": "^1.0.0",
    "i18next": "^23.0.0",
    "liquidjs": "^10.0.0"
  },
  "translations": {
    "es": {
      "name": "Búsquedas de indicativos QRZ.com",
      "description": "Busca los datos de un indicativo con una cuenta de QRZ.com, y envía tus contactos a QRZ.com Logbook",
      "keywords": [
        "indicativo",
        "búsqueda"
      ]
    }
  }
}
