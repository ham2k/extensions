{
  "name": "@ham2k/ext-ki2d-contest-live-scoreboard",
  "version": "0.1.1",
  "private": true,
  "description": "Ham2K Logger extension: posts a contest score to Contest Online ScoreBoard and shows the station's place on it",
  "author": "Sebastian Delmont <sd@ham2k.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --import ../../../scripts/sdk-node-resolve.mjs --experimental-strip-types --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && h2kext-pack build"
  },
  "dependencies": {
    "@ham2k/lib-panel-themes": "^0.1.0"
  },
  "devDependencies": {
    "@ham2k/extension-sdk": "^1.28.0",
    "@ham2k/extension-tools": "^1.28.0",
    "esbuild": "^0.25.5"
  },
  "engines": {
    "node": ">=24"
  }
}
