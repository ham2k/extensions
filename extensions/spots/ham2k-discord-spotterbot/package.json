{
  "name": "@ham2k/ext-ham2k-discord-spotterbot",
  "version": "0.2.0",
  "private": true,
  "description": "Ham2K Logger extension: self-spots posted to Discord servers through Ham2K's Spotterbot",
  "author": "Sebastian Delmont <sd@ham2k.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --import ../../../scripts/sdk-node-resolve.mjs --experimental-strip-types --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && h2kext-pack build --force-name"
  },
  "devDependencies": {
    "@ham2k/extension-sdk": "^1.13.0",
    "@ham2k/extension-tools": "^1.13.0",
    "esbuild": "^0.25.5"
  },
  "engines": {
    "node": ">=24"
  }
}
