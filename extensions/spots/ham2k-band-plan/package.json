{
  "name": "@ham2k/ext-ham2k-band-plan",
  "version": "0.1.0",
  "private": true,
  "description": "The band plan where the station is, as band annotations",
  "author": "Sebastian Delmont <sd@ham2k.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
