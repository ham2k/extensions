{
  "key": "ham2k-satellites",
  "name": "Satellite Operations",
  "shortName": "Sats",
  "version": "0.1.0",
  "description": "Log contacts through amateur satellites, with the bird and its transponder",
  "category": "activity",
  "enabledByDefault": false,
  "icon": "satellite-variant",
  "accentColor": "#3F51B5",
  "api": 1,
  "keywords": [
    "satellite",
    "sat",
    "amsat",
    "transponder"
  ],
  "hooks": [
    "activity",
    "adifFields",
    "adifImport",
    "command",
    "dataFile",
    "ref:satellite"
  ],
  "domains": [
    "polo.ham2k.com"
  ],
  "sharedDependencies": {
    "@ham2k/lib-callsigns": "^1.0.0",
    "@ham2k/lib-country-files": "^1.0.0",
    "@ham2k/lib-dxcc-data": "^1.0.0",
    "@ham2k/lib-format-tools": "^1.0.0",
    "@ham2k/lib-geo-tools": "^1.0.0",
    "@ham2k/lib-operation-data": "^1.0.0",
    "i18next": "^23.0.0",
    "liquidjs": "^10.0.0"
  },
  "translations": {
    "es": {
      "description": "Registra contactos vía satélites de radioaficionados, con el satélite y su transpondedor",
      "keywords": [
        "satélite",
        "sat",
        "amsat",
        "transpondedor"
      ]
    }
  }
}
