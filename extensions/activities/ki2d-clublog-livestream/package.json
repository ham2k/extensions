{
  "name": "@ham2k/ext-ki2d-clublog-livestream",
  "version": "0.1.0",
  "private": true,
  "description": "Ham2K Logger extension: each logged contact sent to Club Log as it is made, feeding the station's Live Stream",
  "author": "Sebastian Delmont <sd@ham2k.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --import ../../../scripts/sdk-node-resolve.mjs --experimental-strip-types --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && h2kext-pack build"
  },
  "devDependencies": {
    "@ham2k/extension-sdk": "^1.15.0",
    "@ham2k/extension-tools": "^1.15.0",
    "esbuild": "^0.25.5"
  },
  "engines": {
    "node": ">=24"
  }
}
